# ===============================================
# Docker 環境變數配置 - LinkWise 全棧開發環境
# ===============================================

# -------- 一般配置 --------
NODE_ENV=development

# -------- 資料庫配置 --------
# PostgreSQL 連接設定
DB_HOST=database
DB_PORT=5432
DB_USER=linkwise_user
DB_PASSWORD=linkwise_password
DB_NAME=linkwise_db

# -------- 後端配置 --------
BACKEND_PORT=8080

# -------- 前端配置 --------
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080

# -------- APP URL --------
APP_URL=http://localhost:8080
