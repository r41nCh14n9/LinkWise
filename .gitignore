
################################
# Project-level ignores
################################

# Environment files (but track examples)
.env
.env.local
.env.*.local
.env*.example
!.env.example

# OS-specific files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE and Editor files
.vscode/
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
.eclipse

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Temporary files
*.tmp
*.temp
.cache/

################################
# Node modules (all locations)
################################
node_modules/

################################
# Frontend (React/TypeScript)
################################
src/linkwise-front/dist/
src/linkwise-front/build/
src/linkwise-front/coverage/
src/linkwise-front/.env.local
src/linkwise-front/.env.*.local

# Testing coverage reports
src/linkwise-front/.nyc_output/
src/linkwise-front/coverage/

# Vite cache
src/linkwise-front/.vite/

# Package lock files (optional - uncomment if team uses lock files)
# src/linkwise-front/package-lock.json
# src/linkwise-front/yarn.lock

################################
